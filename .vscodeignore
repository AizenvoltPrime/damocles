# Development folders
.vscode/**
.vscode-test/**
node_modules/**
!node_modules/@anthropic-ai/**
!node_modules/sql.js-fts5/**
!node_modules/zod/**
!node_modules/web-tree-sitter/**
src/**
.claude/**
logs/**
docs/**

# Config files
.env
.mcp.json
.gitignore
.eslintrc*
tsconfig*.json
vite.config.ts
esbuild.config.mjs
tailwind.config.js
postcss.config.js
components.json

# Build artifacts & lock files
**/*.map
bun.lockb
package-lock.json

# Python sidecar dev artefacts (the runtime ships in dist/, not from source tree)
python/**/.venv/**
python/**/__pycache__/**
**/*.pyc
**/*.pyo
python/**/*.egg-info/**
python/**/tests/**
python/**/uv.lock
python/**/.pytest_cache/**
python/**/.ruff_cache/**
python/**/.mypy_cache/**

# Documentation (README is auto-included by vsce)
*.md
!README.md
!CHANGELOG.md
