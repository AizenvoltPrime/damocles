+import { lstatSync } from "node:fs";
+import { getResourcePathKey } from "./source-info.js";
+const LINK_REFUSED = "link not followed: the link policy refuses it";
+/** Whether linkPolicy admits path; a refusal adds a warning naming path, with message, to diagnostics. */
+export function admitsPath(linkPolicy, path, diagnostics, message = LINK_REFUSED) {
+    if (!linkPolicy || linkPolicy(path))
+        return true;
+    diagnostics?.push({ type: "warning", message, path });
+    return false;
+}
+/**
+ * admitsPath for a name inside a folder the caller already admitted: one lstat, which follows nothing at path, and the
+ * policy is asked only when path is a link.
+ */
+export function admitsEntry(linkPolicy, path, diagnostics) {
+    if (!linkPolicy)
+        return true;
+    let isLink;
+    try {
+        isLink = lstatSync(path).isSymbolicLink();
+    }
+    catch {
+        // The caller's own stat or read of path meets the same error, as it resolves the same name.
+        return true;
+    }
+    return !isLink || admitsPath(linkPolicy, path, diagnostics);
+}
+/** Throws the refusal error, code ELINKPOLICY, when linkPolicy refuses the config file at path for operation. */
+export function assertPathAdmitted(linkPolicy, path, operation) {
+    if (linkPolicy && !linkPolicy(path)) {
+        const refused = operation === "read" ? "Not read" : "Not written";
+        throw Object.assign(new Error(`${refused}: the link policy refuses ${path}`), { code: "ELINKPOLICY" });
+    }
+}
+/** Records dir's realpath; false, with a warning, for a folder the walk already entered. */
+export function enterFolder(visited, dir, diagnostics) {
+    const key = getResourcePathKey(dir);
+    if (!visited.has(key)) {
+        visited.add(key);
+        return true;
+    }
+    diagnostics?.push({
+        type: "warning",
+        message: "folder skipped: this walk already entered it through another path (a link loop or a second link to it)",
+        path: dir,
+    });
+    return false;
+}
