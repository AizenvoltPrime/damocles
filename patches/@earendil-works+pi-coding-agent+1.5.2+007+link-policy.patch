+import type { ResourceDiagnostic } from "./diagnostics.ts";
+/**
+ * A host's rule for following links. Resource walkers call it with the path of a link entry, and of each walk root,
+ * before they stat it; config, context and git metadata reads call it with the file's path before they touch the
+ * file. False skips the entry, or treats the file as unreadable, with a diagnostic.
+ */
+export type LinkPolicy = (path: string) => boolean;
+/** Whether linkPolicy admits path; a refusal adds a warning naming path, with message, to diagnostics. */
+export declare function admitsPath(linkPolicy: LinkPolicy | undefined, path: string, diagnostics?: ResourceDiagnostic[], message?: string): boolean;
+/**
+ * admitsPath for a name inside a folder the caller already admitted: one lstat, which follows nothing at path, and the
+ * policy is asked only when path is a link.
+ */
+export declare function admitsEntry(linkPolicy: LinkPolicy | undefined, path: string, diagnostics?: ResourceDiagnostic[]): boolean;
+/** Throws the refusal error, code ELINKPOLICY, when linkPolicy refuses the config file at path for operation. */
+export declare function assertPathAdmitted(linkPolicy: LinkPolicy | undefined, path: string, operation: "read" | "write"): void;
+/** The folders one recursive walk entered, by realpath, so a link back into one ends there. */
+export type VisitedFolders = Set<string>;
+/** Records dir's realpath; false, with a warning, for a folder the walk already entered. */
+export declare function enterFolder(visited: VisitedFolders, dir: string, diagnostics?: ResourceDiagnostic[]): boolean;
