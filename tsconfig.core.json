{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@xterm/xterm": ["./types/xterm-headless.d.ts"],
      "vscode": ["./types/no-vscode.d.ts"],
      "electron": ["./types/no-electron.d.ts"],
      "electron/*": ["./types/no-electron.d.ts"]
    }
  },
  // Damocles Core, its protocol, the per-process services, the workspace modules, the wire, the daemon, the pty and formatter hosts and the app URL helpers are electron-free too: they run outside main.
  "include": ["src/core", "src/platform", "src/shared", "src/desktop/core-host", "src/desktop/core-protocol", "src/desktop/local-services", "src/desktop/workspace", "src/remote", "src/desktop/daemon", "src/desktop/pty-host", "src/desktop/formatter-host", "src/desktop/app-urls.ts"],
  // Tests are checked by tsconfig.tests*.json.
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.bench.ts"
  ]
}
