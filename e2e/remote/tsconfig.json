// Type-checks the remote end-to-end suite, which imports the desktop suite's support; Playwright runs it untyped.
{
  "extends": "../desktop/tsconfig.json",
  "include": [
    "./**/*.ts",
    "../../playwright.remote.config.ts",
    "../../src/**/*.d.ts",
    // Vitest tests of this suite's support code.
    "../../scripts/__tests__/e2e-review-shots.test.ts",
    "../../scripts/__tests__/reference-package.test.ts",
    "../../scripts/__tests__/release-mirror.test.ts"
  ]
}
