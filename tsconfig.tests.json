// Type-checks what `tsconfig.json` cannot: the test files and the `vscode` mock they run against.
//
// `import ... from 'vscode'` resolves to the ambient `declare module 'vscode'` in `@types/vscode`,
// which wins over any `paths` alias, so both tests and production code are checked against the real
// API. `src/__mocks__/vscode-test-api.d.ts` augments that module with the test-only exports the mock
// adds on top of it (`__setTrusted`, `__watchers`, `FakeFileSystemWatcher`, ...), which is what lets a
// test import them. Pointing the alias at the mock instead would check every `vscode.*` call against
// a stand-in far thinner than the API the extension actually ships against.
//
// `declaration` and `isolatedDeclarations` are off: nothing is emitted from here, and the
// declaration-emit rules only add noise about untyped exports in test helpers.
//
// This is the node-environment half. Suites that declare `// @vitest-environment happy-dom` need the
// DOM lib, which cannot go here: DOM's `Blob`/`fetch` shadow Node's and reject `Buffer`. They are
// checked by `tsconfig.tests.dom.json`, and both halves must stay at zero.
//
// Every strictness flag that affects what a type *is* stays inherited from `tsconfig.json`. The one
// relaxation, `noPropertyAccessFromIndexSignature`, is purely syntactic: `noUncheckedIndexedAccess`
// still widens an index-signature read to `T | undefined` whether it is written `o.k` or `o['k']`.
//
// `scripts/__tests__` are here too. They and some src tests import the scripts by their `.ts` path, as Node runs them
// (scripts/tsconfig.json), and a few import a JavaScript module a tool loads as-is (eslint.config.mjs), typed by `allowJs`.
//
// `npm run typecheck` runs this, so it is a gate at zero. Suppressing a finding here (a cast that
// erases the mismatch, a dropped assertion) buys a green run at the cost of the thing it exists for.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "isolatedDeclarations": false,
    "noPropertyAccessFromIndexSignature": false,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "rootDir": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@/*": ["./src/webview/*"],
      "@xterm/xterm": ["./types/xterm-headless.d.ts"]
    }
  },
  "include": ["src/**/*", "scripts/__tests__/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    // Tests of end-to-end support code that needs the DOM lib, each in an e2e tsconfig's include.
    "scripts/__tests__/e2e-async-children.test.ts",
    "scripts/__tests__/e2e-file-holders.test.ts",
    "scripts/__tests__/e2e-foreground-bound.test.ts",
    "scripts/__tests__/e2e-foreground-queue.test.ts",
    "scripts/__tests__/e2e-pointer.test.ts",
    "scripts/__tests__/e2e-review-shots.test.ts",
    "scripts/__tests__/reference-package.test.ts",
    "scripts/__tests__/release-mirror.test.ts",
    "src/webview",
    // Renderer code with the DOM lib, checked by tsconfig.desktop-preload.json.
    "src/desktop/preload",
    // The Vue shell app and its tests, checked by vue-tsc through tsconfig.webview.json.
    "src/desktop/shell",
    "src/core/browser/__tests__",
    "src/vscode/panels/__tests__/browser-page-strings.test.ts",
    "src/core/pi-session/__tests__/nested-mcp-elicitation.test.ts",
    "src/core/pi-session/__tests__/live-snapshot.test.ts",
    "src/core/pi-session/__tests__/live-chat-page.ts",
    "src/core/chat-panel/message-router/handlers/__tests__/session-handlers-ready.test.ts",
    "src/desktop/core-host/__tests__/panel-views.test.ts",
    "src/core/team/__tests__/redispatch-parity.test.ts",
    "src/core/team/__tests__/member-live-transcript.test.ts",
    "src/core/chat-panel/message-router/handlers/__tests__/consolidation-replay-parity.test.ts",
    "src/core/chat-panel/__tests__/per-device-language.test.ts",
    // Parser input, not project code: multi-language sample files read off disk as text by the
    // compass extraction suites, several of which import modules that intentionally do not exist.
    "src/core/compass/__tests__/fixtures"
  ]
}
