{
  "name": "damocles",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.8.11",
  "publisher": "Aizenvolt",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AizenvoltPrime/damocles.git"
  },
  "bugs": {
    "url": "https://github.com/AizenvoltPrime/damocles/issues"
  },
  "homepage": "https://github.com/AizenvoltPrime/damocles#readme",
  "sponsor": {
    "url": "https://github.com/sponsors/AizenvoltPrime"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "claude",
    "ai",
    "assistant",
    "anthropic",
    "coding",
    "damocles"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:damocles.chat"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "damocles-sidebar",
          "title": "Damocles",
          "icon": "resources/icon.svg"
        }
      ],
      "activitybar": [
        {
          "id": "damocles-compass",
          "title": "Compass",
          "icon": "$(compass)"
        }
      ]
    },
    "views": {
      "damocles-sidebar": [
        {
          "type": "webview",
          "id": "damocles.sidebarView",
          "name": "Damocles",
          "icon": "resources/icon.svg"
        }
      ],
      "damocles-compass": [
        {
          "id": "damocles.compass.explorer",
          "name": "Explorer",
          "when": "config.damocles.compass.enabled"
        },
        {
          "id": "damocles.compass.blastRadius",
          "name": "Blast Radius",
          "when": "config.damocles.compass.enabled"
        }
      ]
    },
    "commands": [
      {
        "command": "damocles.openChat",
        "title": "%command.openChat.title%",
        "category": "Damocles",
        "icon": {
          "light": "resources/icon.png",
          "dark": "resources/icon.png"
        }
      },
      {
        "command": "damocles.newSession",
        "title": "%command.newSession.title%",
        "category": "Damocles"
      },
      {
        "command": "damocles.cancelSession",
        "title": "%command.cancelSession.title%",
        "category": "Damocles"
      },
      {
        "command": "damocles.showLog",
        "title": "%command.showLog.title%",
        "category": "Damocles"
      },
      {
        "command": "damocles.signIn",
        "title": "%command.signIn.title%",
        "category": "Damocles"
      },
      {
        "command": "damocles.signOut",
        "title": "%command.signOut.title%",
        "category": "Damocles"
      },
      {
        "command": "damocles.pickBrowserElement",
        "title": "Pick Browser Element",
        "category": "Damocles"
      },
      {
        "command": "damocles.browser.toggleDevTools",
        "title": "Toggle Developer Tools",
        "category": "Damocles",
        "icon": "$(terminal)"
      },
      {
        "command": "damocles.compass.rebuild",
        "title": "Rebuild Knowledge Graph",
        "category": "Compass",
        "icon": "$(refresh)"
      },
      {
        "command": "damocles.compass.showBlastRadius",
        "title": "Show Blast Radius",
        "category": "Compass",
        "icon": "$(broadcast)"
      },
      {
        "command": "damocles.compass.search",
        "title": "Search Entities",
        "category": "Compass",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "damocles.openChat",
          "group": "navigation"
        },
        {
          "command": "damocles.browser.toggleDevTools",
          "when": "activeWebviewPanelId == 'damocles-browser-view'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "damocles.compass.rebuild",
          "when": "view == damocles.compass.explorer",
          "group": "navigation"
        },
        {
          "command": "damocles.compass.search",
          "when": "view == damocles.compass.explorer",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "damocles.openChat",
        "key": "ctrl+shift+u",
        "mac": "cmd+shift+u"
      },
      {
        "command": "damocles.browser.toggleDevTools",
        "key": "f12",
        "when": "activeWebviewPanelId == 'damocles-browser-view'"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "damocles.permissionMode": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "acceptEdits",
            "auto",
            "plan"
          ],
          "enumDescriptions": [
            "%configuration.permissionMode.default%",
            "%configuration.permissionMode.acceptEdits%",
            "%configuration.permissionMode.auto%",
            "%configuration.permissionMode.plan%"
          ],
          "description": "%configuration.permissionMode.description%"
        },
        "damocles.maxTurns": {
          "type": "number",
          "default": 300,
          "minimum": 1,
          "maximum": 1000,
          "description": "%configuration.maxTurns.description%"
        },
        "damocles.model": {
          "type": "string",
          "default": "",
          "description": "%configuration.model.description%"
        },
        "damocles.maxBudgetUsd": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 0,
          "description": "%configuration.maxBudgetUsd.description%"
        },
        "damocles.taskBudget": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1,
          "description": "%configuration.taskBudget.description%"
        },
        "damocles.maxThinkingTokens": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "minimum": 1000,
          "maximum": 63999,
          "description": "%configuration.maxThinkingTokens.description%"
        },
        "damocles.thinkingDisabled": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.thinkingDisabled.description%"
        },
        "damocles.effortByModel": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "low",
              "medium",
              "high",
              "xhigh",
              "max",
              null
            ]
          },
          "description": "%configuration.effortByModel.description%"
        },
        "damocles.betasEnabled": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "context-1m-2025-08-07"
            ]
          },
          "default": [],
          "description": "%configuration.betasEnabled.description%"
        },
        "damocles.enableFileCheckpointing": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableFileCheckpointing.description%"
        },
        "damocles.agentProgressSummaries": {
          "type": "boolean",
          "default": true,
          "description": "Enable agent progress summaries (~30s interval status updates from subagents)"
        },
        "damocles.maxIndexedFiles": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 50000,
          "description": "%configuration.maxIndexedFiles.description%"
        },
        "damocles.sandbox": {
          "type": "object",
          "default": {
            "enabled": false
          },
          "description": "%configuration.sandbox.description%",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.sandbox.enabled.description%"
            },
            "autoAllowBashIfSandboxed": {
              "type": "boolean",
              "default": true,
              "description": "%configuration.sandbox.autoAllowBashIfSandboxed.description%"
            },
            "allowUnsandboxedCommands": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.sandbox.allowUnsandboxedCommands.description%"
            },
            "networkAllowedDomains": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [],
              "description": "%configuration.sandbox.networkAllowedDomains.description%"
            },
            "networkAllowLocalBinding": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.sandbox.networkAllowLocalBinding.description%"
            }
          }
        },
        "damocles.providerProfiles": {
          "type": "array",
          "default": [],
          "scope": "window",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "%configuration.providerProfiles.name.description%"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "%configuration.providerProfiles.env.description%"
              }
            },
            "required": [
              "name",
              "env"
            ]
          },
          "description": "%configuration.providerProfiles.description%"
        },
        "damocles.activeProviderProfile": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "window",
          "description": "%configuration.activeProviderProfile.description%"
        },
        "damocles.debug": {
          "type": "boolean",
          "default": false,
          "description": "Enable SDK debug logging. Debug output is written to the file specified by damocles.debugFile."
        },
        "damocles.debugFile": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Write SDK debug logs to this file path. Implicitly enables debug mode."
        },
        "damocles.memory.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable persistent memory system"
        },
        "damocles.memory.pinnedTokenBudget": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 2000,
          "description": "Token budget for pinned memories that are always injected in full"
        },
        "damocles.memory.catalogObservationLimit": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 50,
          "description": "Maximum observation entries shown in the memory catalog"
        },
        "damocles.memory.catalogProjectLimit": {
          "type": "number",
          "default": 15,
          "minimum": 5,
          "maximum": 50,
          "description": "Maximum project memory entries shown in the memory catalog"
        },
        "damocles.memory.catalogGlobalLimit": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 50,
          "description": "Maximum global memory entries shown in the memory catalog"
        },
        "damocles.contextStrategy": {
          "type": "string",
          "default": "default",
          "enum": [
            "default",
            "recall"
          ],
          "enumDescriptions": [
            "%configuration.contextStrategy.default%",
            "%configuration.contextStrategy.recall%"
          ],
          "description": "%configuration.contextStrategy.description%"
        },
        "damocles.recallSubcallModel": {
          "type": "string",
          "default": "claude-haiku-4-5-20251001",
          "description": "Model used for sub-calls within the recall loop (e.g. summarization)."
        },
        "damocles.recallMaxIterations": {
          "type": "number",
          "default": 15,
          "minimum": 1,
          "maximum": 30,
          "description": "Maximum number of REPL iterations in the recall loop."
        },
        "damocles.recallMaxInjectedChars": {
          "type": "number",
          "default": 400000,
          "minimum": 200000,
          "maximum": 800000,
          "description": "Maximum characters of recall context injected per prompt (~4 chars per token; default 400K chars ≈ 100K tokens, max 800K ≈ 200K tokens)."
        },
        "damocles.chrome.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Chrome browser integration via the Chrome Extension MCP server."
        },
        "damocles.browser.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Damocles Browser integration with CDP automation and element picker."
        },
        "damocles.team.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable collaborative multi-agent team system"
        },
        "damocles.compass.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable workspace knowledge graph (Compass) for structural code queries"
        },
        "damocles.compass.excludePatterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Regex patterns for files to exclude from Compass indexing"
        },
        "damocles.compass.autoReindex": {
          "type": "boolean",
          "default": true,
          "description": "Automatically reindex when files change"
        },
        "damocles.compass.blastRadiusDepth": {
          "type": "number",
          "default": 2,
          "minimum": 1,
          "maximum": 5,
          "description": "Maximum traversal depth for blast radius analysis"
        },
        "damocles.voice.provider": {
          "type": "string",
          "default": "openai-whisper",
          "enum": [
            "openai-whisper",
            "deepgram",
            "google-cloud-stt"
          ],
          "enumDescriptions": [
            "OpenAI Whisper API",
            "Deepgram Nova-2 API",
            "Google Cloud Speech-to-Text API"
          ],
          "description": "Speech-to-text provider for voice input."
        },
        "damocles.voice.language": {
          "type": "string",
          "default": "en",
          "description": "Language code for voice transcription (e.g., 'en', 'el', 'de')."
        },
        "damocles.autoCompact": {
          "type": "object",
          "default": {
            "enabled": false,
            "warningThreshold": 60,
            "softThreshold": 70,
            "hardThreshold": 75
          },
          "description": "%configuration.autoCompact.description%",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": false,
              "description": "%configuration.autoCompact.enabled.description%"
            },
            "warningThreshold": {
              "type": "number",
              "default": 60,
              "minimum": 15,
              "maximum": 90,
              "description": "%configuration.autoCompact.warningThreshold.description%"
            },
            "softThreshold": {
              "type": "number",
              "default": 70,
              "minimum": 15,
              "maximum": 95,
              "description": "%configuration.autoCompact.softThreshold.description%"
            },
            "hardThreshold": {
              "type": "number",
              "default": 75,
              "minimum": 15,
              "maximum": 95,
              "description": "%configuration.autoCompact.hardThreshold.description%"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "fetch:grammars": "node scripts/fetch-grammars.mjs",
    "build": "npm run fetch:grammars && npm run build:extension && npm run build:webview",
    "build:extension": "node esbuild.config.mjs",
    "build:webview": "vite build",
    "watch": "concurrently \"npm run watch:extension\" \"npm run watch:webview\"",
    "watch:extension": "node esbuild.config.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev": "npm run watch",
    "typecheck": "tsc --noEmit",
    "package": "npx @vscode/vsce package",
    "publish": "npx @vscode/vsce publish",
    "pretest": "npm run fetch:grammars",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.vue",
    "test:memory": "node scripts/test-memory.js",
    "generate:profiles": "node scripts/generate-agent-profiles.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.114",
    "@chenglou/pretext": "^0.0.5",
    "@vueuse/core": "^14.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "diff": "^8.0.2",
    "dompurify": "^3.3.2",
    "fzf": "^0.5.2",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-types": "^0.24.8",
    "lucide-vue-next": "^0.562.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.7.0",
    "shiki": "^3.20.0",
    "sql.js-fts5": "^1.4.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "vue-i18n": "^11.2.8",
    "vue-sonner": "^2.0.9",
    "vue3-lottie": "^3.3.1",
    "web-tree-sitter": "^0.24.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vscode/l10n-dev": "^0.0.35",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "gray-matter": "^4.0.3",
    "marked": "^15.0.0",
    "tailwindcss": "^4.0.0",
    "tar": "^7.5.13",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.0",
    "vue": "^3.5.0"
  }
}
