{
  // Damocles port of .claude/settings.json hooks. Scripts are self-contained and
  // live next to this file in .damocles/hooks/. See docs/hooks.md for the contract.
  "hooks": {
    "tool_call": [
      {
        "match": "^ExitPlanMode$",
        "command": "uv run \"${workspaceFolder}/.damocles/hooks/exit_plan_mode.py\"",
        "timeoutMs": 5000,
        "description": "Notify when a plan is ready for review (CC PreToolUse:ExitPlanMode)"
      },
      {
        "match": "^AskUserQuestion$",
        "command": "uv run \"${workspaceFolder}/.damocles/hooks/ask_user_question.py\"",
        "timeoutMs": 5000,
        "description": "Notify when the agent asks a question (CC PreToolUse:AskUserQuestion)"
      }
    ],
    "permission_required": [
      {
        "command": "uv run \"${workspaceFolder}/.damocles/hooks/notification.py\" --notify",
        "description": "Notify when the agent is waiting on your approval (CC Notification)"
      }
    ],
    "agent_end": [
      {
        "command": "uv run \"${workspaceFolder}/.damocles/hooks/stop.py\" --chat",
        "description": "Announce turn completion + dump transcript (CC Stop)"
      }
    ],
    "subagent_end": [
      {
        "command": "uv run \"${workspaceFolder}/.damocles/hooks/subagent_stop.py\"",
        "description": "Announce subagent completion (CC SubagentStop)"
      }
    ]
  }
}
